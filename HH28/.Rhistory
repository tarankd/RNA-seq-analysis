knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(Seurat)
library(patchwork)
library(ggplot2)
library(DoubletFinder)
library(tidyverse)
library(RColorBrewer)
library(cowplot)
library(openxlsx)
# colour palette
my_cols <- brewer.pal(n=5, "Spectral")
## feature and cell count function
FeatCellCount <- function(seuratObj){dim(seuratObj)
}
#create a workbook that contains assigns each clusters data to its own sheet
cluster_workbook <- function(data, n_clusters){
wb <- createWorkbook()
addWorksheet(wb, "Markers")
writeData(wb, sheet = "Markers", x = filtered_markers)
for(i in 0:n_clusters){
cluster_data <- filtered_markers[filtered_markers$cluster == i,]
addWorksheet(wb, as.character(i))
writeData(wb, sheet = as.character(i), x = cluster_data)
saveWorkbook(wb, file = "filtered_markers.xlsx", overwrite = TRUE)
}
}
#top 5 genes for each cluster, sorted largest to smallest for avg log, more than 0.1 for pct.1 and less than 0.05 for p val adj
top5 <- function(sObj){
clusters <- filtered_markers %>% group_by(cluster) %>% arrange(cluster, desc(avg_log2FC)) %>% filter(pct.1 > 0.1) %>% filter(p_val_adj < 0.05) %>% top_n(5, avg_log2FC)
return(clusters)
}
Progenitor_markers <- FeaturePlot(HH28D, features = c("ATOH7", "HES6"))
Progenitor_markers <- FeaturePlot(HH30F, features = c("ATOH7", "HES6"))
amacrine <- FeaturePlot(HH30F, features = c("TFAP2A", "TFAP2B", "PROX1", "LHX1"))
early_cone_photoreceptors <- FeaturePlot(HH30F, features = c("RAX2", "RXRG", "CRX"))
neural_retina <- FeaturePlot(HH30F, features = c("SMOC1", "ALDH1A3", "VAX1", "VSX2", "CDH2"))
related_to_RPE_and_RPC <- FeaturePlot(HH30F, features = c("TYR", "TYRP", "WNT2B", "BCN"))
retinal_ganglion_cells <- FeaturePlot(HH30F, features = c("ELAVL4", "NEFL", "NEFM", "CL12", "GAP43", "STMN", "POU4F3", "SATB1", "SATB2", "PAX6", "RBPMS2"))
retinal_progenitor_cells <- FeaturePlot(HH30F, features = c("ZIC1", "VSX2", "PAX6", "VAX1", "SMOC1", "PMPR1B", "ATOH7", "HES6"))
endothelial_and_blood <- FeaturePlot(HH30F, features = c("VWF", "KDR"))
POM <- FeaturePlot(HH30F, features = c("PITX2", "EMX2", "LMX1B", "PAX7", "ALX1", "LMX1B", "ALX4", "DCN", "LTBP1", "COL3A1"))
RPE <- FeaturePlot(HH30F, features = c("OTX2", "MITF", "TYR", "TYRP1", "PITX2", "PMEL", "CDH1"))
pioneer <- FeaturePlot(HH30F, features = c("PAX2", "CLYBL", "NTN1", "MET", "EGF", "DVL1", "GALNT6", "FOXP2", "CDH2"))
blood <- FeaturePlot(HH30F, features = c("HBE1", "HBBA", "HBAD", "HBA1", "HBE", "HBZ", "HBBR", "SLC4A1", "SLC39A8", "TSPO2"))
cmz <- FeaturePlot(HH30F, features = c("COL9A1", "CPAMD8", "MECOM", "OPTC", "RELN", "BNC", "FBN2", "FBN3"))
retinal_ganglion_cells
HH30G <- readRDS("../HH30/HH30G/sObj/sObj_4_Markers.RDS")
HH30H <- readRDS("../HH30/HH30H/sObj/sObj_4_Markers.RDS")
