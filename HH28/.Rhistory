related_to_RPE_and_RPC <- FeaturePlot(HH28C, features = c("TYR", "TYRP", "WNT2B", "BCN"), pt.size = 0.5)
rgc<- FeaturePlot(HH28C, features = c("ELAVL4", "NEFL", "NEFM", "CL12", "GAP43", "STMN", "POU4F3", "SATB1", "SATB2", "PAX6", "RBPMS2"), pt.size = 0.5)
rpc <- FeaturePlot(HH28C, features = c("ZIC1", "VSX2", "PAX6", "VAX1", "SMOC1", "PMPR1B", "ATOH7", "HES6"), pt.size = 0.5)
ec <- FeaturePlot(HH28C, features = c("VWF", "KDR"), pt.size = 0.5)
POM <- FeaturePlot(HH28C, features = c("PITX2", "EMX2", "LMX1B", "PAX7", "ALX1", "LMX1B", "ALX4", "DCN", "LTBP1", "COL3A1"), pt.size = 0.5)
RPE <- FeaturePlot(HH28C, features = c("OTX2", "MITF", "TYR", "TYRP1", "PITX2", "PMEL", "CDH1"), pt.size = 0.5)
pioneer <- FeaturePlot(HH28C, features = c("PAX2", "CLYBL", "NTN1", "MET", "EGF", "DVL1", "GALNT6", "FOXP2", "CDH2"), pt.size = 0.5)
blood <- FeaturePlot(HH28C, features = c("HBE1", "HBBA", "HBAD", "HBA1", "HBE", "HBZ", "HBBR", "SLC4A1", "SLC39A8", "TSPO2"), pt.size = 0.5)
cmz <- FeaturePlot(HH28C, features = c("COL9A1", "CPAMD8", "MECOM", "OPTC", "RELN", "BNC", "FBN2", "FBN3"), pt.size = 0.5)
