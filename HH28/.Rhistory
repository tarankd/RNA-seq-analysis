library(dplyr)
library(Seurat)
library(patchwork)
library(ggplot2)
library(DoubletFinder)
library(tidyverse)
library(RColorBrewer)
library(cowplot)
library(openxlsx)
# colour palette
my_cols <- brewer.pal(n=5, "Spectral")
## feature and cell count function
FeatCellCount <- function(seuratObj){dim(seuratObj)
}
s.genes <- cc.genes$s.genes
g2m.genes <- cc.genes$g2m.genes
HH30F <- CellCycleScoring(HH30F, s.features = s.genes, g2m.features = g2m.genes, set.ident = TRUE)
png("cell_cycle_distribution.png", width = 2600, height = 2000)
plots <- RidgePlot(HH30F,
features = c("PCNA","TOP2A","MCM6","MKI67"), ncol = 2,
cols = c("S" = "orange", "G1" = "forestgreen", "G2M" = "steelblue4"),
combine = FALSE)
plots <- lapply(plots, function(p) p +
theme(plot.title = element_text(size = 40),
axis.text = element_text(size = 30),
axis.title.x = element_text(size = 30),
axis.title.y = element_text(size = 30),
legend.text = element_text(size = 30)) +
guides(colour = guide_legend(override.aes = list(size = 30))))
wrap_plots(plots, ncol = 2)
dev.off()
# Update the identity of the Seurat object and define the new order of groups
HH30F@meta.data$Phase <- factor(HH30F@meta.data$Phase, levels = c("G1", "S", "G2M"))
# Reassign identity with the new order
Idents(HH30F) <- HH30F@meta.data$Phase
png("cell_cycle_plot.png", width = 1600, height = 1000)
DimPlot(HH30F, cols = c("S" = "orange", "G1" = "forestgreen", "G2M" = "steelblue4")) +
theme(axis.title = element_text(size = 18), legend.text = element_text(size = 18)) + guides(colour = guide_legend(override.aes = list(size = 10)))
dev.off()
saveRDS(HH30F, file = "/nobackup/proj/comet_icnlmdhuc/Taran/chicken_RNA_seq/HH30/HH30F/sObj/sObj_5_CC.RDS")
