amacrine <- FeaturePlot(HH28C, features = c("TFAP2A", "TFAP2B", "PROX1", "LHX1"), pt.size = 0.5)
ecp <- FeaturePlot(HH28C, features = c("RAX2", "RXRG", "CRX"), pt.size = 0.5)
