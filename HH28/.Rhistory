markers <- FindAllMarkers(HH28C, only.pos = TRUE, group.by = "RNA_snn_res.0.5")
markers %>%
group_by(cluster) %>%
dplyr::filter(avg_log2FC > 1)
write.xlsx(markers, file = "/nobackup/proj/comet_icnlmdhuc/Taran/chicken_RNA_seq/HH28/sample_3/reg-full-markers/HH28C-0.5-reg-full-markers.xlsx")
filtered_markers <- markers %>% filter(!startsWith(gene, "ENSGAL"))
cluster_workbook(filtered_markers, 12)
