HH30H@meta.data$Phase <- factor(HH30H@meta.data$Phase, levels = c("G1", "S", "G2M"))
# Reassign identity with the new order
Idents(HH30H) <- HH30H@meta.data$Phase
DimPlot(HH30H, cols = c("S" = "orange", "G1" = "forestgreen", "G2M" = "steelblue4", group_by = "Phase"))
ggsave("/nobackup/proj/comet_icnlmdhuc/Taran/chicken_RNA_seq/HH30/HH30H/plots/cc_reg_diff.png", dpi = 400)
saveRDS(HH30H, "/nobackup/proj/comet_icnlmdhuc/Taran/chicken_RNA_seq/HH30/HH30H/sObj/sObj_7_reg_diff.RDS")
rm("HH30H")
setwd("../HH30T/")
HH30T <- readRDS("sObj/sObj_4_Markers.RDS")
knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(Seurat)
library(patchwork)
library(ggplot2)
library(DoubletFinder)
library(tidyverse)
library(RColorBrewer)
library(cowplot)
library(openxlsx)
# colour palette
my_cols <- brewer.pal(n=5, "Spectral")
## feature and cell count function
FeatCellCount <- function(seuratObj){dim(seuratObj)
}
s.genes <- cc.genes$s.genes
g2m.genes <- cc.genes$g2m.genes
HH30T <- CellCycleScoring(HH30T, s.features = s.genes, g2m.features = g2m.genes, set.ident = TRUE)
png("cell_cycle_distribution.png", width = 2600, height = 2000)
plots <- RidgePlot(HH30T,
features = c("PCNA","TOP2A","MCM6","MKI67"), ncol = 2,
cols = c("S" = "orange", "G1" = "forestgreen", "G2M" = "steelblue4"),
combine = FALSE)
plots <- lapply(plots, function(p) p +
theme(plot.title = element_text(size = 40),
axis.text = element_text(size = 30),
axis.title.x = element_text(size = 30),
axis.title.y = element_text(size = 30),
legend.text = element_text(size = 30)) +
guides(colour = guide_legend(override.aes = list(size = 30))))
wrap_plots(plots, ncol = 2)
dev.off()
# Update the identity of the Seurat object and define the new order of groups
HH30T@meta.data$Phase <- factor(HH30T@meta.data$Phase, levels = c("G1", "S", "G2M"))
# Reassign identity with the new order
Idents(HH30T) <- HH30T@meta.data$Phase
png("cell_cycle_plot.png", width = 1600, height = 1000)
DimPlot(HH30T, cols = c("S" = "orange", "G1" = "forestgreen", "G2M" = "steelblue4")) +
theme(axis.title = element_text(size = 18), legend.text = element_text(size = 18)) + guides(colour = guide_legend(override.aes = list(size = 10)))
dev.off()
saveRDS(HH30T, file = "sObj_5_CC.RDS")
